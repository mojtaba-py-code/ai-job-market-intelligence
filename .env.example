# ---------------------------------------------------------------------------
# JMI Platform — example environment file.
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
#
# Every value here maps to a field on `jmi.config.Settings`. In production the
# app refuses to start with a placeholder secret, a default admin password, or a
# wildcard CORS policy that allows credentials — see SECURITY.md.
# ---------------------------------------------------------------------------

# Core
JMI_ENV=development                     # development | staging | production
JMI_DEBUG=true

# Security — REQUIRED in production. Generate with:
#   python -m jmi secret-key
# Must be at least 32 characters. Use a different key per environment: sharing
# one lets a token minted for staging authenticate against production.
JMI_SECRET_KEY=change-me-to-a-long-random-string
JMI_ACCESS_TOKEN_TTL_MINUTES=30

# JWT signing algorithm. Restricted to HS256 / HS384 / HS512; `none` and the
# asymmetric families are rejected at startup.
JMI_ALGORITHM=HS256

# Tokens are bound to this issuer/audience pair and rejected if either differs,
# so a token from another deployment cannot be replayed here.
JMI_JWT_ISSUER=jmi-platform
JMI_JWT_AUDIENCE=jmi-api

# Number of reverse proxies in front of the app. Leave at 0 when the app is
# directly exposed: X-Forwarded-For is then ignored entirely, because a client
# can forge it and mint a fresh rate-limit identity per request. Set it to the
# EXACT number of proxies (1 behind a single load balancer) — a value higher
# than reality reintroduces the bypass.
JMI_TRUSTED_PROXY_HOPS=0

# Serve /docs, /redoc and /openapi.json. Unset means "off in production, on
# everywhere else". Set to true only if a public API reference is intended.
# JMI_DOCS_ENABLED=false

# Database. Defaults to a local SQLite file when unset so the app runs out of
# the box. For production use PostgreSQL, e.g.:
#   JMI_DATABASE_URL=postgresql+psycopg://jmi:password@localhost:5432/jmi
JMI_DATABASE_URL=sqlite:///./data/runtime/jmi.sqlite3

# API server
JMI_API_HOST=127.0.0.1
JMI_API_PORT=8000

# Comma-separated list of allowed origins. `*` is permitted ONLY when
# JMI_CORS_ALLOW_CREDENTIALS=false — together they would let any website read
# authenticated responses on a logged-in visitor's behalf.
JMI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JMI_CORS_ALLOW_CREDENTIALS=true

# Rate limiting (per client, sliding window)
JMI_RATE_LIMIT_REQUESTS=120
JMI_RATE_LIMIT_WINDOW_SECONDS=60

# A tighter budget for /auth/login, /auth/token and /auth/register, so the
# generous global limit above cannot double as a password-guessing allowance.
JMI_AUTH_RATE_LIMIT_REQUESTS=10
JMI_AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# Upper bound on distinct clients the in-memory limiter tracks. Caps the memory
# a flood of unique source addresses can consume.
JMI_RATE_LIMIT_MAX_TRACKED_CLIENTS=50000

# Crawler etiquette
JMI_CRAWLER_USER_AGENT=JMIBot/1.0 (+https://example.com/bot; contact@example.com)
JMI_CRAWLER_RESPECT_ROBOTS=true
JMI_CRAWLER_REQUEST_DELAY_SECONDS=1.0
JMI_CRAWLER_MAX_RETRIES=3
JMI_CRAWLER_TIMEOUT_SECONDS=20

# Largest response the crawler will accept, in bytes (default 8 MiB). Stops a
# hostile or broken source from streaming an unbounded body into memory.
JMI_CRAWLER_MAX_RESPONSE_BYTES=8388608

# Optional infrastructure (used only if the extras are installed)
JMI_REDIS_URL=redis://localhost:6379/0
JMI_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Notifications (optional; leave blank to disable)
JMI_SMTP_HOST=
JMI_SMTP_PORT=587
JMI_SMTP_USERNAME=
JMI_SMTP_PASSWORD=
JMI_SMTP_FROM=alerts@example.com
JMI_TELEGRAM_BOT_TOKEN=
JMI_TELEGRAM_CHAT_ID=

# First admin bootstrap (created by `jmi seed` if not present).
# Both values below are placeholders and are REJECTED when JMI_ENV=production:
# the app refuses to boot rather than seed an administrator whose credentials
# are published in this repository. Generate a real password with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# Rotate it after first login regardless.
JMI_ADMIN_EMAIL=admin@example.com
JMI_ADMIN_PASSWORD=change-me-strong-password

# ---------------------------------------------------------------------------
# docker compose only. Both are REQUIRED — the stack refuses to start without
# them rather than falling back to a guessable default. Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ---------------------------------------------------------------------------
POSTGRES_USER=jmi
POSTGRES_PASSWORD=
POSTGRES_DB=jmi
REDIS_PASSWORD=
