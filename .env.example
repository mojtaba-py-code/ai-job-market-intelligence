# ---------------------------------------------------------------------------
# JMI Platform — example environment file.
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# Core
JMI_ENV=development                     # development | staging | production
JMI_DEBUG=true

# Security — REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JMI_SECRET_KEY=change-me-to-a-long-random-string
JMI_ACCESS_TOKEN_TTL_MINUTES=30
JMI_ALGORITHM=HS256

# Database. Defaults to a local SQLite file when unset so the app runs out of
# the box. For production use PostgreSQL, e.g.:
#   JMI_DATABASE_URL=postgresql+psycopg://jmi:password@localhost:5432/jmi
JMI_DATABASE_URL=sqlite:///./data/runtime/jmi.sqlite3

# API server
JMI_API_HOST=127.0.0.1
JMI_API_PORT=8000
JMI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate limiting (per client, sliding window)
JMI_RATE_LIMIT_REQUESTS=120
JMI_RATE_LIMIT_WINDOW_SECONDS=60

# Crawler etiquette
JMI_CRAWLER_USER_AGENT=JMIBot/1.0 (+https://example.com/bot; contact@example.com)
JMI_CRAWLER_RESPECT_ROBOTS=true
JMI_CRAWLER_REQUEST_DELAY_SECONDS=1.0
JMI_CRAWLER_MAX_RETRIES=3
JMI_CRAWLER_TIMEOUT_SECONDS=20

# Optional infrastructure (used only if the extras are installed)
JMI_REDIS_URL=redis://localhost:6379/0
JMI_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Notifications (optional; leave blank to disable)
JMI_SMTP_HOST=
JMI_SMTP_PORT=587
JMI_SMTP_USERNAME=
JMI_SMTP_PASSWORD=
JMI_SMTP_FROM=alerts@example.com
JMI_TELEGRAM_BOT_TOKEN=
JMI_TELEGRAM_CHAT_ID=

# First admin bootstrap (created by `jmi seed` if not present)
JMI_ADMIN_EMAIL=admin@example.com
JMI_ADMIN_PASSWORD=change-me-strong-password
